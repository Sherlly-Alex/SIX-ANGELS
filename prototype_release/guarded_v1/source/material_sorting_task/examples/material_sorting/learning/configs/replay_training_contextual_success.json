{
  "schema_version": "scheduler-replay-training-v1",
  "episode_length": 256,
  "randomize": true,
  "domain_randomization": {
    "pose_noise_std_m": 0.01,
    "yaw_noise_std_rad": 0.015,
    "detection_noise_std": 0.02,
    "depth_scale_range": [0.99, 1.01],
    "speed_scale_range": [0.95, 1.05],
    "friction_scale_range": [0.95, 1.05],
    "message_latency_s_range": [0.0, 0.05],
    "detection_dropout_probability": 0.01,
    "planner_failure_probability": 0.01,
    "dynamic_obstacle_probability": 0.03
  },
  "reward": {
    "best_reward": 1.0,
    "utility_regret_scale": 0.15,
    "invalid_action_reward": -100.0,
    "success_weight": 0.0,
    "outcome_success_weight": 6.0,
    "time_penalty_weight": 0.02
  }
}
