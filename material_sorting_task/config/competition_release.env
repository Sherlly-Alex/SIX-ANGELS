# Frozen prototype defaults. Keep this file shell-compatible and dependency-free.
MATERIAL_RELEASE_ID=qzhrl-guarded-prototype-2026-08-27
MATERIAL_ACCEPTANCE_BASE_COMMIT=e3f5284
MATERIAL_VALIDATED_MOTION_COMMIT=e3f5284

ROS_DOMAIN_ID=102
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
MATERIAL_EXECUTION_MODE=task123_full
MATERIAL_SCHEDULER_ENGINE=v2
# Formal launches default to the deterministic Heuristic policy.  The value
# below identifies the explicitly requested Guarded capability for preflight;
# it does not make Guarded the default client mode.
MATERIAL_DEFAULT_CLIENT_MODE=heuristic
MATERIAL_SCHEDULER_POLICY=rl_guarded
MATERIAL_MEASURED_CARRY_GUARD=0
MATERIAL_LOOP_HEALTH_PERIOD_S=5.0
MATERIAL_DETECT_BACKEND=yolo
MATERIAL_DETECTION_LOG_PERIOD=0

# Immutable guarded-policy release assets. Paths are relative to PROJECT.
MATERIAL_RL_MODEL_RELATIVE_PATH=release_assets/rl_guarded/scheduler_policy.zip
MATERIAL_RL_MODEL_SHA256=5340c47b1fbcfaf799667e1b36a2474e7809817abca78e38875f690a222fb785
MATERIAL_RL_APPROVAL_RELATIVE_PATH=release_assets/rl_guarded/scheduler_guarded_approval.json
MATERIAL_RL_APPROVAL_SHA256=0f92ad4a1a0039c9dbefc54d3710aeba38910b0aaf259a443db7dd9af9a95f0a
MATERIAL_RL_DEVICE=cpu
MATERIAL_RL_TIMEOUT_MS=50
MATERIAL_RL_QUARANTINE_AFTER_TIMEOUTS=3

MATERIAL_OFFICIAL_SEED=20260817
MATERIAL_SERVER_IMAGE=material_sorting:offline-server
MATERIAL_GUARDED_CLIENT_IMAGE=material_sorting:offline-client-rl-shadow-e3f5284
MATERIAL_HEURISTIC_CLIENT_IMAGE=material_sorting:offline-client
